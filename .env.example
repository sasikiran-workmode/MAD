# Groq LLM Configuration
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=3

# Search Configuration (optional – leave blank to use free DuckDuckGo/Wikipedia)
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SEARCH_BASE_URL=https://www.googleapis.com/customsearch/v1

# NLI Configuration
NLI_MODEL=ynie/roberta-large-snli_mnli_fever_anli_R1_R2_R3-nli
NLI_DEVICE=cpu
# Set to "mock" to skip model loading (FIXTURE / dev mode only)
NLI_MODE=transformers

# Debate Configuration
DISAGREEMENT_THRESHOLD=0.70
ENTAILMENT_THRESHOLD=0.70
MAX_DEBATE_ROUNDS=3
MAX_SEARCH_RESULTS=5
NLI_MAX_CLAIMS=3

# Application
DEMO_MODE=false
ALLOW_RULE_FALLBACK=true
LOG_LEVEL=INFO
